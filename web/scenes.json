{
  "_help": "One entry per note file. 'steps' must have the same number of entries as the note's Steps. outlook states: closed, broken, loading, ok, safe, freezing, password, disconnected, connecting, nosearch, search_ok. Window item states: normal, new, removed, selected, bad, on, off. 'outlook' is applied when the cursor clicks the highlighted control (or immediately if there is none); 'outlook_after' follows after 'after_ms'.",

  "01-profile-corrupt-after-migration.md": {
    "initial": { "outlook": "broken", "caption": "User reports: Outlook will not open since the cloud migration" },
    "steps": [
      { "caption": "Closing Outlook completely",
        "outlook": "closed",
        "window": { "title": "Task Manager", "icon": "📊",
          "items": [ { "text": "Microsoft Outlook (outlook.exe)", "state": "removed", "tag": "ended" },
                     { "text": "Microsoft Teams" }, { "text": "Microsoft Edge" } ],
          "buttons": [ { "text": "End task", "hl": true } ] } },
      { "caption": "Opening Control Panel → Mail (Microsoft Outlook) (32-bit)",
        "outlook": "closed",
        "window": { "title": "Mail Setup - Outlook", "icon": "✉",
          "hint": "Control Panel › Mail (Microsoft Outlook) (32-bit)",
          "items": [ { "text": "Outlook-Old", "state": "bad", "tag": "migrated profile" } ],
          "buttons": [ { "text": "Show Profiles…", "hl": true }, { "text": "E-mail Accounts…" } ] } },
      { "caption": "Adding a NEW profile that sets itself up automatically",
        "outlook": "closed",
        "window": { "title": "Mail", "icon": "✉",
          "hint": "Profiles available on this computer:",
          "items": [ { "text": "Outlook-Old", "state": "bad", "tag": "corrupt" },
                     { "text": "Outlook-New", "state": "new", "tag": "new profile" } ],
          "progress": { "value": 100, "label": "Setting up user@contoso.com automatically…" },
          "buttons": [ { "text": "Add…", "hl": true }, { "text": "Remove" }, { "text": "Properties" } ] } },
      { "caption": "Making the new profile the default",
        "outlook": "closed",
        "window": { "title": "Mail", "icon": "✉",
          "hint": "When starting Microsoft Outlook, use this profile:",
          "items": [ { "text": "Outlook-Old", "state": "bad" },
                     { "text": "Outlook-New", "state": "selected", "tag": "default" } ],
          "buttons": [ { "text": "Always use this profile", "hl": true, "primary": true }, { "text": "OK" } ] } },
      { "caption": "Opening Outlook with the new profile…",
        "outlook": "loading", "outlook_after": "ok", "after_ms": 2600,
        "window": null },
      { "caption": "Outlook works, so the old profile can go",
        "outlook": "ok",
        "window": { "title": "Mail", "icon": "✉",
          "items": [ { "text": "Outlook-Old", "state": "removed", "tag": "removed" },
                     { "text": "Outlook-New", "state": "selected", "tag": "default" } ],
          "buttons": [ { "text": "Remove", "hl": true }, { "text": "OK" } ] } }
    ]
  },

  "02-outlook-hangs-addin.md": {
    "initial": { "outlook": "freezing", "caption": "User reports: Outlook freezes and crashes when it starts" },
    "steps": [
      { "caption": "Closing the frozen Outlook",
        "outlook": "closed",
        "window": { "title": "Task Manager", "icon": "📊",
          "items": [ { "text": "Microsoft Outlook (Not responding)", "state": "removed", "tag": "ended" },
                     { "text": "Microsoft Teams" } ],
          "buttons": [ { "text": "End task", "hl": true } ] } },
      { "caption": "Starting Outlook in Safe Mode (add-ins do not load)",
        "outlook": "loading", "outlook_after": "safe", "after_ms": 2400,
        "window": { "title": "Run", "icon": "▶",
          "hint": "Type the name of a program, folder or document:",
          "items": [ { "text": "outlook.exe /safe", "state": "selected" } ],
          "buttons": [ { "text": "OK", "hl": true, "primary": true }, { "text": "Cancel" } ] } },
      { "caption": "Safe Mode works, so an add-in is the suspect. Opening File → Options",
        "outlook": "safe",
        "window": { "title": "Outlook Options", "icon": "⚙",
          "items": [ { "text": "General" }, { "text": "Mail" }, { "text": "Search" },
                     { "text": "Add-ins", "state": "selected", "hl": true } ],
          "buttons": [ { "text": "OK" } ] } },
      { "caption": "Manage: COM Add-ins → Go…",
        "outlook": "safe",
        "window": { "title": "Outlook Options — Add-ins", "icon": "⚙",
          "hint": "Manage: COM Add-ins",
          "items": [ { "text": "CRM Sync Add-in", "state": "on", "tag": "slow to start" },
                     { "text": "PDF Maker", "state": "on" },
                     { "text": "Teams Meeting Add-in", "state": "on" },
                     { "text": "Spell Helper", "state": "on" } ],
          "buttons": [ { "text": "Go…", "hl": true } ] } },
      { "caption": "Unticking every add-in, then restarting Outlook normally",
        "outlook": "loading", "outlook_after": "ok", "after_ms": 2400,
        "window": { "title": "COM Add-ins", "icon": "⚙",
          "items": [ { "text": "CRM Sync Add-in", "state": "off" },
                     { "text": "PDF Maker", "state": "off" },
                     { "text": "Teams Meeting Add-in", "state": "off" },
                     { "text": "Spell Helper", "state": "off" } ],
          "buttons": [ { "text": "OK", "hl": true, "primary": true } ] } },
      { "caption": "Turning add-ins back on one at a time. The CRM add-in brings the freeze back",
        "outlook": "freezing",
        "window": { "title": "COM Add-ins", "icon": "⚙",
          "items": [ { "text": "PDF Maker", "state": "on" },
                     { "text": "Teams Meeting Add-in", "state": "on" },
                     { "text": "Spell Helper", "state": "on" },
                     { "text": "CRM Sync Add-in", "state": "bad", "tag": "problem returns!" } ],
          "buttons": [ { "text": "OK", "hl": true, "primary": true } ] } },
      { "caption": "Leaving the problem add-in off. Outlook is stable again",
        "outlook": "ok",
        "window": { "title": "COM Add-ins", "icon": "⚙",
          "items": [ { "text": "PDF Maker", "state": "on" },
                     { "text": "Teams Meeting Add-in", "state": "on" },
                     { "text": "Spell Helper", "state": "on" },
                     { "text": "CRM Sync Add-in", "state": "off", "tag": "left off" } ],
          "buttons": [ { "text": "OK", "hl": true, "primary": true } ] } }
    ]
  },

  "03-password-prompt-loop.md": {
    "initial": { "outlook": "password", "caption": "User reports: Outlook keeps asking for the password" },
    "steps": [
      { "caption": "Closing Outlook",
        "outlook": "closed",
        "window": { "title": "Task Manager", "icon": "📊",
          "items": [ { "text": "Microsoft Outlook (outlook.exe)", "state": "removed", "tag": "ended" },
                     { "text": "Microsoft Teams" } ],
          "buttons": [ { "text": "End task", "hl": true } ] } },
      { "caption": "Control Panel → Credential Manager → Windows Credentials",
        "outlook": "closed",
        "window": { "title": "Credential Manager", "icon": "🔑",
          "hint": "Control Panel › Credential Manager › Windows Credentials",
          "items": [ { "text": "MicrosoftOffice16_Data:SSPI:user@contoso.com", "state": "bad", "tag": "stale" },
                     { "text": "MicrosoftOffice16_Data:orgid:user@contoso.com", "state": "bad", "tag": "stale" },
                     { "text": "outlook.office365.com", "state": "bad", "tag": "stale" },
                     { "text": "TERMSRV/fileserver01" },
                     { "text": "WindowsLive:target=virtualapp/didlogical" } ],
          "buttons": [ { "text": "Remove", "hl": true } ] } },
      { "caption": "Removing only the Office / Outlook entries",
        "outlook": "closed",
        "window": { "title": "Credential Manager", "icon": "🔑",
          "items": [ { "text": "MicrosoftOffice16_Data:SSPI:user@contoso.com", "state": "removed", "tag": "removed" },
                     { "text": "MicrosoftOffice16_Data:orgid:user@contoso.com", "state": "removed", "tag": "removed" },
                     { "text": "outlook.office365.com", "state": "removed", "tag": "removed" },
                     { "text": "TERMSRV/fileserver01" },
                     { "text": "WindowsLive:target=virtualapp/didlogical" } ],
          "buttons": [ { "text": "Remove", "hl": true } ] } },
      { "caption": "Restarting Outlook and signing in once",
        "outlook": "loading", "outlook_after": "ok", "after_ms": 2600,
        "window": { "title": "Sign in", "icon": "🔒",
          "hint": "Sign in to user@contoso.com",
          "items": [ { "text": "Password  ••••••••••", "state": "selected" } ],
          "buttons": [ { "text": "Sign in", "hl": true, "primary": true } ] } },
      { "caption": "Only needed if the prompt comes back: create a new profile",
        "outlook": "ok",
        "window": null }
    ]
  },

  "04-not-syncing-disconnected.md": {
    "initial": { "outlook": "disconnected", "caption": "User reports: Outlook shows Disconnected and no new mail arrives" },
    "steps": [
      { "caption": "Checking the internet and the mailbox on the web",
        "outlook": "disconnected",
        "window": { "title": "Microsoft Edge — Outlook on the web", "icon": "🌐",
          "items": [ { "text": "Internet connection is working", "state": "on" },
                     { "text": "Mailbox loads on the web, so the mailbox is healthy", "state": "on" } ],
          "buttons": [ { "text": "Open Outlook on the web", "hl": true } ] } },
      { "caption": "Send/Receive tab: making sure Work Offline is not switched on",
        "outlook": "disconnected",
        "window": { "title": "Outlook — Send/Receive", "icon": "✉",
          "items": [ { "text": "Send/Receive All Folders" },
                     { "text": "Update Folder" },
                     { "text": "Work Offline", "state": "off", "tag": "now off" } ],
          "buttons": [ { "text": "Work Offline", "hl": true } ] } },
      { "caption": "Closing and reopening Outlook",
        "outlook": "loading", "outlook_after": "connecting", "after_ms": 2200,
        "window": null },
      { "caption": "Running Send/Receive All Folders (F9)",
        "outlook": "ok",
        "window": { "title": "Send/Receive Progress", "icon": "🔄",
          "hint": "Send/Receive All Folders (F9)",
          "items": [ { "text": "Inbox", "state": "on", "tag": "synchronised" } ],
          "progress": { "value": 100, "label": "Synchronising folders…" },
          "buttons": [ { "text": "Close", "hl": true } ] } },
      { "caption": "Only if it is still disconnected: restart the PC and try again",
        "outlook": "ok",
        "window": null },
      { "caption": "Still stuck? Then create a new profile (see the profile fix)",
        "outlook": "ok",
        "window": null }
    ]
  },

  "05-search-not-working.md": {
    "initial": { "outlook": "nosearch", "caption": "User reports: search finds nothing, although the mail is there" },
    "steps": [
      { "caption": "File → Options → Search → Indexing Options",
        "outlook": "nosearch",
        "window": { "title": "Indexing Options", "icon": "🔎",
          "items": [ { "text": "Microsoft Outlook", "state": "bad", "tag": "index incomplete" },
                     { "text": "Users (C:\\Users)" } ],
          "buttons": [ { "text": "Advanced…", "hl": true } ] } },
      { "caption": "Advanced → Rebuild the search index",
        "outlook": "nosearch",
        "window": { "title": "Advanced Options", "icon": "🔎",
          "hint": "Troubleshooting. Rebuilding can take a long time on a big mailbox.",
          "items": [ { "text": "Delete and rebuild the index" } ],
          "buttons": [ { "text": "Rebuild", "hl": true, "primary": true } ] } },
      { "caption": "Re-indexing with Outlook open (fast-forwarded for this demo)",
        "outlook": "nosearch", "outlook_after": "search_ok", "after_ms": 2600,
        "window": { "title": "Indexing Options", "icon": "🔎",
          "items": [ { "text": "Microsoft Outlook", "state": "on", "tag": "indexing" } ],
          "progress": { "value": 100, "label": "Indexing… 48,213 items" },
          "buttons": [ { "text": "Close", "hl": true } ] } },
      { "caption": "Checking the mail is still safe on the web",
        "outlook": "search_ok",
        "window": { "title": "Microsoft Edge — Outlook on the web", "icon": "🌐",
          "items": [ { "text": "All mail is still in the mailbox", "state": "on" } ],
          "buttons": [ { "text": "Open Outlook on the web", "hl": true } ] } },
      { "caption": "Search works. If it ever stays broken, create a new profile",
        "outlook": "search_ok",
        "window": null }
    ]
  }
}
